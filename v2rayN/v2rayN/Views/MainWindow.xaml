                            <Expander Header="系统代理兼容模式" Foreground="{StaticResource ShellMuted}" Margin="0,12,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="当前使用应用分流时，保持系统代理关闭即可。" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" /><WrapPanel><Button x:Name="personalEnableProxy" Content="开启系统代理" Click="PersonalEnableProxy_Click" Style="{StaticResource ShellButton}" Margin="0,0,10,0" /><Button x:Name="personalClearProxy" Content="关闭系统代理" Click="PersonalClearProxy_Click" Style="{StaticResource ShellButton}" /></WrapPanel></StackPanel></Expander>
                            <TextBlock x:Name="personalSettingsStatus" Foreground="{StaticResource ShellAccent}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" />
                            <TextBlock Text="氯离子 VPN · 基于 v2rayN 7.25.6 / GPL-3.0" Foreground="#82959E" FontSize="11" Margin="0,25,0,0" />
