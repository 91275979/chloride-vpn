                            <DockPanel Margin="0,26,0,12"><Button Content="添加应用" Click="PersonalAddApp_Click" Style="{StaticResource ShellPrimaryButton}" DockPanel.Dock="Right" /><StackPanel VerticalAlignment="Center"><TextBlock Text="应用名单" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="选择应用文件，即可加入名单。" Foreground="{StaticResource ShellMuted}" FontSize="12" Margin="0,5,0,0" /></StackPanel></DockPanel>
                            <Border Background="White" BorderBrush="{StaticResource ShellLine}" BorderThickness="1" CornerRadius="12" Padding="18,4">
                                <StackPanel><ItemsControl x:Name="personalAppList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E8EFF1" BorderThickness="0,0,0,1" Padding="0,14"><DockPanel><Button Content="移出" Tag="{Binding ProcessName}" Click="PersonalRemoveApp_Click" Style="{StaticResource ShellLink}" DockPanel.Dock="Right" VerticalAlignment="Center" /><Border Width="38" Height="38" Background="#E8F3F2" CornerRadius="10" DockPanel.Dock="Left" Margin="0,0,13,0"><TextBlock Text="{Binding Initials}" Foreground="#187A72" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="#193442" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="{Binding ProcessName}" Foreground="#71848E" FontSize="11" Margin="0,5,0,0" /></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="personalAppsEmpty" Text="还没有应用。点击“添加应用”选择需要走节点的软件。" Foreground="{StaticResource ShellMuted}" TextWrapping="Wrap" Margin="0,18" /></StackPanel>
                            </Border>
                            <TextBlock x:Name="personalAppRoutingStatus" Text="正在读取应用规则。" Foreground="{StaticResource ShellMuted}" FontSize="12" TextWrapping="Wrap" Margin="2,14,0,0" />
                            <Border BorderBrush="{StaticResource ShellLine}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,20,0,0"><DockPanel><Button x:Name="personalRouting" Content="编辑网站规则" Style="{StaticResource ShellButton}" DockPanel.Dock="Right" /><StackPanel><TextBlock Text="Edge 的网站规则" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="浏览器选“按网站”时使用。未匹配的网站默认直连。" Foreground="{StaticResource ShellMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,7,16,0" /></StackPanel></DockPanel></Border>
                            <Expander Header="按进程名编辑（高级）" Margin="0,22,0,0" Foreground="{StaticResource ShellMuted}"><StackPanel Margin="0,12,0,0"><TextBox x:Name="personalProxyApps" Style="{StaticResource ShellInput}" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="应用进程名名单" /><Button Content="保存名单" Click="PersonalSaveAppRouting_Click" Style="{StaticResource ShellButton}" HorizontalAlignment="Left" Margin="0,12,0,0" /></StackPanel></Expander>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="设置">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="personalSettingsPage" Margin="32,12,32,28" TextElement.Foreground="{StaticResource ShellInk}">
                            <TextBlock Text="启动与窗口" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                            <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource ShellLine}" BorderThickness="1" Padding="22,6"><StackPanel>
                                <DockPanel Margin="0,16"><ToggleButton x:Name="personalAutoRun" Style="{StaticResource ShellToggle}" Click="PersonalAutoRun_Click" DockPanel.Dock="Right" AutomationProperties.Name="开机自启动" /><StackPanel><TextBlock Text="开机自启动" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="登录 Windows 后自动打开氯离子。" Foreground="{StaticResource ShellMuted}" FontSize="12" Margin="0,6,12,0" /></StackPanel></DockPanel>
                                <Border BorderBrush="#E8EFF1" BorderThickness="0,1,0,0" /><DockPanel Margin="0,16"><ToggleButton x:Name="personalAutoHide" Style="{StaticResource ShellToggle}" Click="PersonalAutoHide_Click" DockPanel.Dock="Right" AutomationProperties.Name="启动时最小化" /><StackPanel><TextBlock Text="启动时最小化" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="连接继续运行，窗口留在任务栏。" Foreground="{StaticResource ShellMuted}" FontSize="12" Margin="0,6,12,0" /></StackPanel></DockPanel>
                            </StackPanel></Border>
                            <TextBlock Text="节点管理" FontSize="18" FontWeight="SemiBold" Margin="0,25,0,8" /><TextBlock Text="分享链接只保存在本机。" Foreground="{StaticResource ShellMuted}" FontSize="12" Margin="0,0,0,14" />
                            <WrapPanel><Button x:Name="personalImport" Content="导入节点" Style="{StaticResource ShellPrimaryButton}" Margin="0,0,10,10" /><Button x:Name="personalImage" Content="扫描二维码" Style="{StaticResource ShellButton}" Margin="0,0,10,10" /><Button x:Name="personalSubscription" Content="管理订阅" Style="{StaticResource ShellButton}" Margin="0,0,0,10" /></WrapPanel>
                            <TextBlock Text="网络与高级选项" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,13" />
